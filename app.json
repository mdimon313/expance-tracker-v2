{
  "expo": {
    "name": "Expense Tracker",
    "slug": "expance-tracker-v2",
    "scheme": "expensetracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/android-icon-monochrome.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.expensetracker",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to log in quickly and securely.",
        "NSLocationWhenInUseUsageDescription": "Location helps tag where your transactions happen.",
        "NSPhotoLibraryUsageDescription": "Allow photo access to set your profile picture.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.yourcompany.expensetracker",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/android-icon-foreground.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0F172A",
          "image": "./src/assets/android-splash.png",
          "imageWidth": 200,
          "resizeMode": "cover"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Location helps tag where your transactions happen."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./src/assets/notification-icon.png",
          "color": "#10B981"
        }
      ],
      "expo-font",
      "expo-localization",
      "expo-image",
      "expo-status-bar",
      "expo-splash-screen"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "b84f94e9-2a84-4c54-950c-6592462634e3"
      }
    },
    "owner": "mdimon313s-team"
  }
}
